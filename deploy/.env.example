# Variables compartidas por todo el stack (docker compose las lee de deploy/.env).
# Copiá este archivo a deploy/.env y completá los valores. Nunca subas deploy/.env.

# Base de datos compartida (Supabase / PostgreSQL)
DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=your-password

# JWT: el mismo secreto en ms-users (emite) y en gateway + microservicios (validan)
JWT_SECRET=local-dev-only-change-this-secret-key-at-least-32-bytes
JWT_EXPIRATION=1h
JWT_ISSUER=reservas-ms-users

# Admin inicial que crea ms-users si no existe
SECURITY_BOOTSTRAP_EMAIL=admin@reservas.local
SECURITY_BOOTSTRAP_PASSWORD=ChangeMe123!

# Puertos publicados en el host
FRONTEND_PORT=5173
GATEWAY_PORT=8080
EUREKA_PORT=8761
REDIS_PORT=6379
REDIS_INSIGHT_PORT=5540
